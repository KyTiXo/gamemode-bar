{
	"name": "gamemode-bar",
	"private": true,
	"version": "0.2.4",
	"type": "module",
	"scripts": {
		"build": "bun run scripts/build.ts app",
		"build:debug": "bun run scripts/build.ts debug",
		"check": "bun test && bun run lint",
		"commitlint": "commitlint --edit",
		"sync-version": "bun run scripts/sync-version.ts",
		"dev": "bun run install:local",
		"install:local": "bun run scripts/install-local.ts",
		"lint": "bunx biome check . && swiftc -typecheck -framework AppKit -framework ServiceManagement src/native/GameModeBar.swift",
		"prepare": "husky",
		"readme:build": "bunx readme-aura build --source .github/readme.source.md",
		"release": "standard-version && bun run sync-version && git add src/native/Info.plist && git commit --amend --no-edit --no-verify",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@types/bun": "latest",
		"husky": "^9.1.7",
		"standard-version": "^9.5.0"
	}
}
